{
  "name": "codex-claude-bridge",
  "version": "0.4.0",
  "private": true,
  "description": "codex-claude-bridge: trusted-local stdio MCP server that lets Claude Code delegate tasks and native image generation to the locally installed, logged-in Codex CLI. Not a security boundary.",
  "license": "MIT",
  "homepage": "https://github.com/NTD-Consulting-Ventures/codex-claude-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NTD-Consulting-Ventures/codex-claude-bridge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codex-claude-bridge": "dist/src/server.js",
    "codex-image-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 src test scripts",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/server.js",
    "register": "node scripts/register.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2"
  }
}
