{
  "name": "codex-image-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Trusted-local stdio MCP server that delegates tasks to the locally installed, logged-in Codex CLI (app-server). Not a security boundary.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codex-image-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 src test scripts",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/server.js",
    "register": "node scripts/register.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2"
  }
}
